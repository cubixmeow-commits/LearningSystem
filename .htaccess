# Keep data and lessons outside the public docroot when possible.
# If this whole tree is web-exposed on shared hosting, deny sensitive paths
# and route the site through public/.

<IfModule mod_authz_core.c>
  <If "%{REQUEST_URI} =~ m#/(data|src|tmp|lessons)/#">
    Require all denied
  </If>
</IfModule>

<Files "learn.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

<FilesMatch "\.(sqlite|sqlite3|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Already inside public/: do nothing.
  RewriteRule ^public($|/) - [L]
  # Block sensitive trees before rewriting.
  RewriteRule ^(data|src|tmp|lessons|docs)(/|$) - [F,L]
  RewriteRule ^learn\.php$ - [F,L]
  # Serve the app from public/ while keeping URLs under /learn/.
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
